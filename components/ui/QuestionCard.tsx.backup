'use client';

import { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Question } from '@/lib/questions';

interface QuestionCardProps {
  question: Question;
  onAnswer: (value: boolean | number | string | (string | number)[]) => void;
  onNextMultiSelect?: () => void;
  initialSelectedMultiValues?: (string | number)[];
}

export function QuestionCard({ question, onAnswer, onNextMultiSelect, initialSelectedMultiValues = [] }: QuestionCardProps) {
  const [numberValue, setNumberValue] = useState('');
  const [selectedMultiOptions, setSelectedMultiOptions] = useState<(string | number)[]>(initialSelectedMultiValues);

  useEffect(() => {
    // Reset number input and multi-select state when question changes
    setNumberValue('');
    setSelectedMultiOptions(initialSelectedMultiValues);
  }, [question.id, initialSelectedMultiValues]);

  const handleNumberSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const value = parseInt(numberValue, 10);
    if (!isNaN(value)) {
      onAnswer(value);
    }
  };

  const handleMultiOptionClick = (value: string | number) => {
    setSelectedMultiOptions(prevSelected => {
      if (prevSelected.includes(value)) {
        return prevSelected.filter(v => v !== value);
      } else {
        return [...prevSelected, value];
      }
    });
  };

  const cardVariants = {
    initial: { opacity: 0, x: 100 },
    animate: { opacity: 1, x: 0 },
    exit: { opacity: 0, x: -100 },
  };

  return (
    <motion.div
      key={question.id}
      variants={cardVariants}
      initial="initial"
      animate="animate"
      exit="exit"
      transition={{ duration: 0.3, ease: 'easeInOut' }}
      className="glass-panel p-6 rounded-xl shadow-2xl w-full border border-green-500/30 box-neon-green"
    >
      <h3 className="text-xl md:text-3xl text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-cyan-400 mb-8 text-center font-bold font-roboto-mono tracking-wider">
        {question.text}
      </h3>

      {question.type === 'boolean' && (
        <div className="flex space-x-6">
          <button
            onClick={() => onAnswer(true)}
            className="flex-1 bg-green-900/40 hover:bg-green-600 text-green-400 hover:text-white border border-green-500 font-bold py-4 px-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-[0_0_20px_rgba(0,255,128,0.5)] active:scale-95"
          >
            <span className="text-xl font-roboto-mono">YES</span>
            <br /><span className="text-sm opacity-80">縺ｯ縺・/span>
          </button>
          <button
            onClick={() => onAnswer(false)}
            className="flex-1 bg-gray-900/40 hover:bg-red-600 text-gray-400 hover:text-white border border-gray-600 hover:border-red-500 font-bold py-4 px-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-[0_0_20px_rgba(255,0,0,0.5)] active:scale-95"
          >
            <span className="text-xl font-roboto-mono">NO</span>
            <br /><span className="text-sm opacity-80">縺・＞縺・/span>
          </button>
        </div>
      )}

      {question.type === 'number' && (
        <form onSubmit={handleNumberSubmit} className="flex space-x-4">
          <div className="relative flex-1">
            <input
              type="number"
              value={numberValue}
              onChange={(e) => setNumberValue(e.target.value)}
              placeholder="驥鷹｡阪ｒ蜈･蜉・
              className="w-full px-6 py-4 bg-black/50 text-white text-xl font-mono border border-green-500/50 rounded-xl focus:outline-none focus:border-green-400 focus:shadow-[0_0_15px_rgba(0,255,128,0.3)] pr-12 transition-all"
              required
              autoFocus
            />
            <span className="absolute inset-y-0 right-0 flex items-center pr-4 text-green-400 font-bold">{question.meta?.unit || '蜀・}</span>
          </div>
          <button type="submit" className="bg-green-600 hover:bg-green-500 text-black font-bold py-4 px-8 rounded-xl transition-all duration-300 hover:shadow-[0_0_20px_rgba(0,255,128,0.6)] hover:scale-105">
            <span className="font-roboto-mono">NEXT</span>
          </button>
        </form>
      )}

      {question.type === 'select' && question.options && (
        <>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {question.options.map((option) => {
              const isSelected = question.multiple && selectedMultiOptions.includes(option.value);
              return (
                <button
                  key={option.value}
                  onClick={() => {
                    if (question.multiple) {
                      handleMultiOptionClick(option.value);
                    } else {
                      onAnswer(option.value);
                    }
                  }}
                  className={`
                    relative overflow-hidden group
                    ${isSelected
                      ? 'bg-green-600 text-black border-green-400 shadow-[0_0_15px_rgba(0,255,128,0.5)]'
                      : 'bg-black/40 text-gray-300 border-gray-700 hover:border-green-500 hover:text-green-400'}
                    border font-bold py-4 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] text-center
                  `}
                >
                  <span className="relative z-10">{option.label}</span>
                  {!isSelected && <div className="absolute inset-0 bg-green-500/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300" />}
                </button>
              );
            })}
          </div>
          {question.multiple && (
            <div className="mt-6 text-center">
              <button
                onClick={() => {
                  onAnswer(selectedMultiOptions);
                  onNextMultiSelect?.(); // Call the next handler from parent
                }}
                disabled={selectedMultiOptions.length === 0}
                className="bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-bold py-4 px-12 rounded-full transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_0_20px_rgba(0,200,255,0.4)] hover:shadow-[0_0_30px_rgba(0,200,255,0.6)] hover:scale-105 font-roboto-mono tracking-widest"
              >
                NEXT STEP
              </button>
            </div>
          )}
        </>
      )}
    </motion.div>
  );
}
