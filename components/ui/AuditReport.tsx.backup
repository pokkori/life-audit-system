'use client';

import { useMemo } from 'react';
import { AuditResultReport, DisplayCategory } from '@/types/audit';
import { AccordionCard } from './AccordionCard';
import { ShareButtons } from './ShareButtons';
import { CreatorProfile } from './CreatorProfile';
import { LIFETIME_AGE } from '@/lib/AuditEngine';

export function AuditReport({ report, age }: { report: AuditResultReport, age: number }) {
  // NaN髦ｲ豁｢: remainingYears縺ｮ螳牙・縺ｪ險育ｮ・  const remainingYears = useMemo(() => {
    const fromReport = report.remainingYears;
    const calculated = LIFETIME_AGE - age;

    // NaN繝√ぉ繝・け
    if (fromReport && !isNaN(fromReport) && fromReport > 0) {
      return fromReport;
    }
    if (!isNaN(calculated) && calculated > 0) {
      return calculated;
    }
    return 55; // 繝・ヵ繧ｩ繝ｫ繝亥､・・0豁ｳ諠ｳ螳夲ｼ・  }, [report.remainingYears, age]);

  // 譛螟ｧ繝ｪ繧ｹ繧ｯ繧ｫ繝・ざ繝ｪ繧堤音螳・  const topRiskCategory = useMemo(() => {
    if (!report.breakdown || report.breakdown.length === 0) {
      return '蜈亥ｻｶ縺ｰ縺・;
    }
    const sorted = [...report.breakdown].sort((a, b) => b.financialLoss - a.financialLoss);
    return sorted[0]?.item.displayCategory || '蜈亥ｻｶ縺ｰ縺・;
  }, [report.breakdown]);

  const groupedBreakdown = useMemo(() => {
    return report.breakdown.reduce((acc, item) => {
      const category = item.item.displayCategory;
      if (!acc[category]) {
        acc[category] = [];
      }
      acc[category].push(item);
      return acc;
    }, {} as Record<DisplayCategory, typeof report.breakdown>);
  }, [report.breakdown]);

  return (
    <div className="space-y-8 w-full">
      {/* 繧ｵ繝槭Μ繝ｼ繧ｫ繝ｼ繝会ｼ育判蜒丈ｿ晏ｭ倡畑・・*/}
      <div id="result-card" className="glass-panel rounded-xl p-8 space-y-6 border border-amber-500/30 shadow-[0_0_20px_rgba(245,158,11,0.15)] relative overflow-hidden">
        <div className="text-center relative z-10">
          <h2 className="text-2xl font-bold text-gray-300 mb-2 tracking-widest font-roboto-mono">逕滓ｶｯ謳榊､ｱ 逶｣譟ｻ繝ｬ繝昴・繝・/h2>
          <p className="text-gray-400 text-lg">縺ゅ↑縺溘・逕滓ｶｯ・医≠縺ｨ{remainingYears}蟷ｴ髢難ｼ峨・謗ｨ螳壽錐螟ｱ鬘・/p>
          <div className="my-8 flex justify-center items-center gap-1 w-full overflow-hidden px-2">
            <span className="text-xl sm:text-2xl md:text-3xl font-bold text-red-600 font-roboto-mono flex-shrink-0">ﾂ･</span>
            <p className="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-red-600 font-roboto-mono text-neon-blood animate-heartbeat-heavy tracking-tighter leading-none whitespace-nowrap">
              {Math.round(report.totalFinancialLoss).toLocaleString()}
            </p>
          </div>
          <div className="mt-6 p-4 bg-amber-900/20 border border-amber-500/50 rounded-lg max-w-md mx-auto">
            <p className="text-sm text-amber-400 uppercase tracking-widest font-roboto-mono mb-1">MAJOR FINANCIAL LEAK</p>
            <p className="text-xl text-white font-bold">
              譛蜆ｪ蜈域隼蝟・・岼: 縲須topRiskCategory}縲・            </p>
          </div>
        </div>

        {/* 繧ｷ繧ｧ繧｢逕ｨ繝上ャ繧ｷ繝･繧ｿ繧ｰ陦ｨ遉ｺ */}
        <div className="text-center pt-4 border-t border-gray-700/50">
          <p className="text-xs text-gray-500 font-mono tracking-wider">#莠ｺ逕溘・逶｣譟ｻ繝ｬ繝昴・繝・#蜈亥ｻｶ縺ｰ縺玲錐螳ｳ險ｺ譁ｭ</p>
        </div>
      </div>

      {/* 謳榊､ｱ縺ｮ蜀・ｨｳ */}
      <div className="space-y-6">
        <h3 className="text-lg font-semibold mb-2 text-gray-300 text-center">謳榊､ｱ縺ｮ蜀・ｨｳ</h3>
        {Object.entries(groupedBreakdown).map(([category, items]) => (
          <div key={category}>
            <h4 className="text-md font-bold text-amber-500 mb-2 pl-2">{category}</h4>
            <div className="space-y-2">
              {items.map((itemResult, index) => (
                <AccordionCard
                  key={index}
                  itemResult={itemResult}
                  remainingYears={remainingYears}
                />
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* 謗ｨ螂ｨ繝代ャ繝・ｼ亥ｺ・相繧ｨ繝ｪ繧｢蠑ｷ蛹也沿・・*/}
      <div className="p-6 bg-gradient-to-br from-gray-900 to-black rounded-xl border border-yellow-500/30 shadow-[0_0_15px_rgba(234,179,8,0.2)]">
        <h3 className="text-lg font-bold mb-6 text-yellow-400 text-center flex items-center justify-center gap-2 font-roboto-mono tracking-wide">
          <svg className="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          RECOMMENDED PATCHES
        </h3>
        <div className="space-y-4">
          {report.recommendedPatches.map((patch, index) => {
            // 繧ｫ繝・ざ繝ｪ縺斐→縺ｮ謳榊､ｱ鬘阪ｒ謚ｽ蜃ｺ・・opy縺九ｉ謨ｰ蛟､繧貞叙蠕暦ｼ・            const amountMatch = patch.copy.match(/邏・[\d,]+)蜀・);
            const recoverableAmount = amountMatch ? amountMatch[1] : Math.round(report.totalFinancialLoss / report.recommendedPatches.length).toLocaleString();

            return (
              <a
                key={index}
                href={patch.link}
                target="_blank"
                rel="noopener noreferrer"
                className="block p-4 bg-gradient-to-r from-gray-800 to-gray-750 rounded-lg border-l-4 border-amber-600 hover:from-gray-700 hover:to-gray-650 transition-all duration-200 shadow-lg hover:shadow-amber-500/10"
              >
                <div className="flex items-start justify-between gap-3">
                  <div className="flex-1">
                    <p className="font-bold text-white text-base mb-1">{patch.title}</p>
                    <p className="text-sm text-gray-400 mb-3">{patch.copy}</p>
                    {/* 蜍慕噪繝吶ロ繝輔ぅ繝・ヨ繧ｳ繝斐・ */}
                    <div className="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-amber-700 to-orange-600 rounded-full text-white text-sm font-bold shadow-md">
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                      </svg>
                      莉翫☆縺仙ｯｾ遲悶＠縺ｦ ﾂ･{recoverableAmount} 繧呈舞縺・                    </div>
                  </div>
                  <div className="flex-shrink-0 text-amber-500">
                    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        <p className="text-xs text-gray-500 text-center mt-4">窶ｻ 荳願ｨ倥・謠先声繧ｵ繝ｼ繝薙せ縺ｸ縺ｮ繝ｪ繝ｳ繧ｯ繧貞性縺ｿ縺ｾ縺・/p>
      </div>

      {/* 繝槭Ν繝ヾNS繧ｷ繧ｧ繧｢繝懊ち繝ｳ */}
      <div className="pt-4">
        <h3 className="text-lg font-semibold mb-4 text-gray-300 text-center">邨先棡繧偵す繧ｧ繧｢</h3>
        <ShareButtons
          totalLoss={report.totalFinancialLoss}
          lossAnalogy={report.lossAnalogy}
          topRiskCategory={topRiskCategory}
          resultCardId="result-card"
        />
      </div>

      <CreatorProfile />
    </div>
  );
}
